---
import { site } from '../data/site';
import { hero } from '../data/hero';

const hasVideo = Boolean(hero.videoPath);
const slides = [...hero.slides];
const hasStills = slides.length > 0;
const canCycleStills = slides.length > 1;
---

<section
  class="relative min-h-screen min-h-[100svh] overflow-hidden hero-atmosphere text-cloud"
  data-hero-section
  data-has-video={hasVideo ? 'true' : 'false'}
>
  {
    hasStills && (
      <div
        class="hero-slideshow"
        data-hero-slideshow={canCycleStills ? 'true' : 'false'}
        data-hold={hero.slideHoldSeconds}
        aria-hidden="true"
      >
        {slides.map((src, index) => (
          <img
            class:list={['hero-media', 'hero-slide', index === 0 && 'is-active']}
            src={src}
            alt=""
            width={hero.posterWidth}
            height={hero.posterHeight}
            fetchpriority={index === 0 ? 'high' : 'low'}
            decoding="async"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
    )
  }

  {
    hasVideo && (
      <video
        class="hero-media hero-video"
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        poster={hero.posterPath}
        aria-label="Background showreel. Click or use the playback control to pause or resume."
      >
        <source src={hero.videoPath} type="video/mp4" />
      </video>
    )
  }

  <div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

  {
    canCycleStills && (
      <div class="hero-controls is-hidden" data-hero-still-controls>
        <button type="button" class="hero-nav" data-hero-prev aria-label="Previous image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M15 5L8 12l7 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="hero-nav" data-hero-next aria-label="Next image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M9 5l7 7-7 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    )
  }

  {
    hasVideo && (
      <button
        type="button"
        class="hero-playback"
        data-hero-playback
        aria-label="Pause background video"
      >
        <span class="hero-playback-icon hero-playback-pause" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="5" width="4" height="14" rx="1"></rect>
            <rect x="14" y="5" width="4" height="14" rx="1"></rect>
          </svg>
        </span>
        <span class="hero-playback-icon hero-playback-play is-hidden" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.5v13l11-6.5-11-6.5z"></path>
          </svg>
        </span>
      </button>
    )
  }

  <div
    class="hero-copy mx-auto flex min-h-screen min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-20 pt-28 md:px-8 md:pb-28"
  >
    <p
      class="reveal font-display text-4xl font-bold tracking-[-0.02em] text-cloud uppercase md:text-6xl lg:text-7xl"
      aria-label={site.shortName}
    >
      EN<span class="text-flare" aria-hidden="true">/</span>SIGHT
    </p>
    <p class="reveal reveal-delay-1 mt-2 text-sm font-medium tracking-[0.18em] text-cloud/75 uppercase md:text-base">
      Creatives
    </p>
    <h1
      class="reveal reveal-delay-2 font-display mt-8 max-w-2xl text-2xl font-semibold leading-snug tracking-tight text-balance text-cloud md:text-4xl"
    >
      Aerial storytelling for Dallas/Fort Worth
    </h1>
    <p class="reveal reveal-delay-3 mt-4 max-w-xl text-base text-cloud/85 md:text-lg">
      Aerial and ground video, photography, and progress docs for brands, events, real estate, and job sites. Part 107
      licensed, based in North Central Texas.
    </p>
    <div class="reveal reveal-delay-3 mt-8 flex flex-wrap gap-3">
      <a
        href="/contact/"
        class="inline-flex bg-flare px-6 py-3 font-semibold text-ink transition hover:brightness-105"
      >
        Request info
      </a>
      <a
        href="/portfolio/"
        class="inline-flex bg-cloud/10 px-6 py-3 font-medium text-cloud ring-1 ring-cloud/35 transition hover:bg-cloud/20"
      >
        View work
      </a>
    </div>
  </div>
</section>

<script>
  function initHeroMedia() {
    const section = document.querySelector('[data-hero-section]');
    if (!(section instanceof HTMLElement) || section.dataset.heroBound === 'true') return;
    section.dataset.heroBound = 'true';

    const video = section.querySelector('[data-hero-video]');
    const slideshow = section.querySelector('[data-hero-slideshow]');
    const stillControls = section.querySelector('[data-hero-still-controls]');
    const playbackBtn = section.querySelector('[data-hero-playback]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** @type {ReturnType<typeof setInterval> | undefined} */
    let stillTimer;
    let stillsActive = false;

    function setPlaybackUi(paused) {
      if (!(playbackBtn instanceof HTMLButtonElement)) return;
      const pauseIcon = playbackBtn.querySelector('.hero-playback-pause');
      const playIcon = playbackBtn.querySelector('.hero-playback-play');
      pauseIcon?.classList.toggle('is-hidden', paused);
      playIcon?.classList.toggle('is-hidden', !paused);
      playbackBtn.setAttribute('aria-label', paused ? 'Resume background video' : 'Pause background video');
    }

    function toggleVideoPlayback() {
      if (!(video instanceof HTMLVideoElement) || video.classList.contains('is-fallback-hidden')) return;
      if (video.paused) {
        void video.play().then(() => setPlaybackUi(false)).catch(() => activateStillsFallback());
      } else {
        video.pause();
        setPlaybackUi(true);
      }
    }

    function startStills() {
      if (!(slideshow instanceof HTMLElement) || stillsActive) return;
      const slides = Array.from(slideshow.querySelectorAll('.hero-slide'));
      if (slides.length < 2) {
        stillsActive = true;
        stillControls?.classList.add('is-hidden');
        return;
      }

      stillsActive = true;
      stillControls?.classList.remove('is-hidden');
      const hold = Math.max(2, Number(slideshow.dataset.hold || 6)) * 1000;
      let index = slides.findIndex((el) => el.classList.contains('is-active'));
      if (index < 0) index = 0;

      function show(next) {
        slides[index]?.classList.remove('is-active');
        index = (next + slides.length) % slides.length;
        slides[index]?.classList.add('is-active');
      }

      function go(delta) {
        show(index + delta);
        restartAutoplay();
      }

      function restartAutoplay() {
        if (reduceMotion) return;
        if (stillTimer) clearInterval(stillTimer);
        stillTimer = setInterval(() => show(index + 1), hold);
      }

      section.querySelector('[data-hero-prev]')?.addEventListener('click', () => go(-1));
      section.querySelector('[data-hero-next]')?.addEventListener('click', () => go(1));
      restartAutoplay();
    }

    function activateStillsFallback() {
      if (video instanceof HTMLVideoElement) {
        video.pause();
        video.classList.add('is-fallback-hidden');
        video.removeAttribute('autoplay');
      }
      playbackBtn?.classList.add('is-hidden');
      startStills();
    }

    if (video instanceof HTMLVideoElement) {
      // Safari/iOS: attributes alone are not always enough before play().
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      const canPlay =
        video.canPlayType('video/mp4; codecs="avc1.42E01E"') ||
        video.canPlayType('video/mp4');

      if (reduceMotion || !canPlay) {
        activateStillsFallback();
      } else {
        stillControls?.classList.add('is-hidden');
        video.addEventListener('click', toggleVideoPlayback);
        playbackBtn?.addEventListener('click', (event) => {
          event.stopPropagation();
          toggleVideoPlayback();
        });
        video.addEventListener('error', activateStillsFallback);
        video.querySelector('source')?.addEventListener('error', activateStillsFallback);

        const playAttempt = video.play();
        if (playAttempt !== undefined) {
          playAttempt.then(() => setPlaybackUi(false)).catch(() => activateStillsFallback());
        } else {
          setPlaybackUi(!video.paused);
        }

        video.addEventListener('play', () => setPlaybackUi(false));
        video.addEventListener('pause', () => {
          if (!video.classList.contains('is-fallback-hidden')) setPlaybackUi(true);
        });
      }
      return;
    }

    // Stills-only mode (no video configured)
    startStills();
  }

  initHeroMedia();
  document.addEventListener('astro:page-load', initHeroMedia);
</script>
